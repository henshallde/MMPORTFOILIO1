html<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daniel Henshall - illiustrator</title>
    <style>
        /* CSS Reset and Variables */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --bg-color: #000000;          /* Black background */
            --accent-gray: #333333;       /* Gray accent color */
            --card-bg: #ffffff;           /* White content cards */
            --text-dark: #222222;         /* Dark text inside white cards */
            --text-light: #ffffff;        /* Crisp white text for dark areas */
            --nav-bg: #1a1a1a;            /* Dark navigation bar background */
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            line-height: 1.6;
        }

        /* Navigation Bar */
        nav {
            background-color: var(--nav-bg);
            border-bottom: 2px solid var(--accent-gray);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
        }

        .nav-logo {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--text-light);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 20px;
        }

        .nav-links a {
            color: #cccccc;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.3s, border-bottom 0.3s;
            padding-bottom: 5px;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--text-light);
            border-bottom: 2px solid var(--text-light);
        }

        /* Main Content Layout */
        main {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Content White Card */
        .content-card {
            background-color: var(--card-bg);
            color: var(--text-dark);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1);
        }

        .content-card h1 {
            font-size: 2.2rem;
            margin-bottom: 20px;
            color: #000000;
            border-bottom: 2px solid var(--accent-gray);
            padding-bottom: 10px;
        }

        /* Empty Paragraph Placeholder Style */
        .fill-in-placeholder {
            background-color: #f0f0f0;
            border-left: 4px dashed #888888;
            padding: 15px;
            font-style: italic;
            color: #555555;
            margin-bottom: 30px;
            border-radius: 4px;
        }

        /* Photoshop Grid Layout */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 20px;
        }

        /* Target the fourth item to make it full width or centered if desired, 
           or keep them uniform. Here we use an elegant grid setup. */
        .gallery-item {
            background: #f5f5f5;
            border: 1px solid #dddddd;
            border-radius: 6px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .gallery-item img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-bottom: 1px solid #dddddd;
            transition: transform 0.3s ease;
        }

        .gallery-item img:hover {
            transform: scale(1.03);
        }

        .item-caption {
            padding: 12px;
            background: #ffffff;
            font-weight: 500;
            color: var(--text-dark);
            text-align: center;
            font-size: 0.95rem;
        }

        /* Footer Section */
        footer {
            text-align: center;
            padding: 30px;
            margin-top: 60px;
            border-top: 1px solid var(--accent-gray);
            color: #888888;
            font-size: 0.9rem;
        }

        /* Responsive Design */
        @media (max-width: 900px) {
            .gallery-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .nav-container {
                flex-direction: column;
                gap: 15px;
            }
            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 12px;
            }
            .gallery-grid {
                grid-template-columns: 1fr;
            }
            .content-card {
                padding: 25px;
            }
        }
    </style>
</head>
<body>

